{
  "version": 2,
  "rewrites": [
    {
      "has": [
        {
          "type": "host",
          "value": "api.alurproject.web.id"
        }
      ],
      "source": "/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
