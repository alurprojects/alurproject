{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ryux": {
      "type": "remote",
      "url": "http://localhost:8787/mcp",
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "everything": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-everything"
        ]
      }
    }
  }
}